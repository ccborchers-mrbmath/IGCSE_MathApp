# Copy to .env for local development. Set the same values in Netlify's
# environment variables for deploys — Vite inlines them at build time.
#
# Both values below are safe to expose in the browser bundle. The
# service-role key is NOT in this list and must never appear here:
# it belongs only in Supabase edge-function secrets.

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
